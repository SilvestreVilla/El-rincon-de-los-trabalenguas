rules_version = '2';

// Reglas de seguridad de El Rincón de los Trabalenguas.
// Sprint 1: usuarios (HU-01, HU-02) y lectura del catálogo aprobado (HU-04, HU-05).
// Sprint 2: los usuarios proponen trabalenguas en `envios` (HU-12). El cliente sigue sin escribir
// en `trabalenguas`: la semilla se carga con scripts/seed.js (Admin SDK) y la publicación llega con HU-13.

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    function rutaUsuario(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function rutaEnvio(envioId) {
      return /databases/$(database)/documents/envios/$(envioId);
    }

    // HU-12: máximo de envíos pendientes por usuario.
    function maxPendientes() {
      return 5;
    }

    // ---------- usuarios/{uid} ----------
    // El correo es privado: solo el dueño lee su documento.
    match /usuarios/{uid} {
      allow read: if esDueno(uid);

      // HU-01: el registro crea el documento con rol «usuario»,
      // la aceptación del aviso de privacidad y la mayoría de edad.
      allow create: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['email', 'rol', 'aceptoPrivacidad', 'mayorDeEdad', 'creado'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.rol == 'usuario'
        && request.resource.data.aceptoPrivacidad == true
        && request.resource.data.mayorDeEdad == true
        && request.resource.data.creado == request.time;

      // Nadie cambia su propio rol ni su correo desde el cliente.
      // HU-12: lo único que el dueño puede cambiar es su contador de envíos pendientes, y solo
      // subiéndolo de 1 en 1 (hasta 5) en la misma escritura que crea el envío `ultimoEnvio`.
      allow update: if esDueno(uid)
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly([])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enviosPendientes', 'ultimoEnvio'])
            && request.resource.data.enviosPendientes == resource.data.get('enviosPendientes', 0) + 1
            && request.resource.data.enviosPendientes <= maxPendientes()
            && request.resource.data.ultimoEnvio is string
            && !exists(rutaEnvio(request.resource.data.ultimoEnvio))
            && existsAfter(rutaEnvio(request.resource.data.ultimoEnvio))
            && getAfter(rutaEnvio(request.resource.data.ultimoEnvio)).data.autorId == uid));

      // La eliminación de cuenta llega en el Sprint 4 (HU-18).
      allow delete: if false;
    }

    // ---------- trabalenguas/{id} ----------
    // HU-04 y HU-05: cualquiera, con o sin sesión, lee solo los aprobados.
    // Un trabalenguas pendiente o rechazado se comporta como «no encontrado».
    match /trabalenguas/{id} {
      allow read: if resource.data.estado == 'aprobado';
      allow write: if false;
    }

    // ---------- progreso/{uid}_{trabalenguasId} ----------
    // HU-07 (favoritos), HU-08 (dominado) y HU-09 (temporizador).
    // Cada usuario lee y escribe únicamente su propio progreso (RNF-03).
    match /progreso/{docId} {
      allow get: if autenticado() && docId.matches(request.auth.uid + '_.*');
      allow list: if autenticado() && resource.data.usuarioId == request.auth.uid;

      allow create, update: if autenticado()
        && docId.matches(request.auth.uid + '_.*')
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.keys().hasOnly(['usuarioId', 'trabalenguasId', 'esFavorito', 'dominado', 'mejorTiempoSeg', 'practicas', 'ultimaPractica'])
        && (!('esFavorito' in request.resource.data) || request.resource.data.esFavorito is bool)
        // HU-08: dominado es un booleano.
        && (!('dominado' in request.resource.data) || request.resource.data.dominado is bool)
        // HU-09: mejor tiempo (segundos, mayor a 0), número de prácticas y fecha de la última práctica.
        && (!('mejorTiempoSeg' in request.resource.data) || (request.resource.data.mejorTiempoSeg is number && request.resource.data.mejorTiempoSeg > 0))
        && (!('practicas' in request.resource.data) || request.resource.data.practicas is int)
        && (!('ultimaPractica' in request.resource.data) || request.resource.data.ultimaPractica is timestamp);

      allow delete: if false;
    }

    // ---------- envios/{envioId} ----------
    // HU-12: propuestas de trabalenguas. Se crean como «pendiente» y no aparecen en el catálogo.
    // Cada envío sube en 1 el contador `enviosPendientes` del autor en la misma escritura (batch);
    // así las reglas imponen el máximo de 5 sin tener que contar documentos.
    match /envios/{envioId} {
      // HU-15: cada autor lee solo sus envíos (las consultas deben filtrar por autorId).
      allow read: if autenticado() && resource.data.autorId == request.auth.uid;

      allow create: if autenticado()
        && request.resource.data.keys().hasOnly(['autorId', 'titulo', 'texto', 'concepto', 'definicion', 'area', 'dificultad', 'estado', 'creado'])
        && request.resource.data.keys().hasAll(['autorId', 'titulo', 'texto', 'concepto', 'definicion', 'area', 'dificultad', 'estado', 'creado'])
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.creado == request.time
        && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 1 && request.resource.data.titulo.size() <= 80
        && request.resource.data.texto is string && request.resource.data.texto.size() >= 20 && request.resource.data.texto.size() <= 500
        && request.resource.data.concepto is string && request.resource.data.concepto.size() >= 1 && request.resource.data.concepto.size() <= 60
        && request.resource.data.definicion is string && request.resource.data.definicion.size() >= 1 && request.resource.data.definicion.size() <= 200
        && request.resource.data.area in ['Scrum', 'Planeación', 'Riesgos', 'Calidad', 'Liderazgo']
        && request.resource.data.dificultad in ['Fácil', 'Medio', 'Difícil']
        // El contador del autor sube en 1 en la misma escritura y apunta a este envío.
        && getAfter(rutaUsuario(request.auth.uid)).data.get('enviosPendientes', 0) == get(rutaUsuario(request.auth.uid)).data.get('enviosPendientes', 0) + 1
        && getAfter(rutaUsuario(request.auth.uid)).data.get('ultimoEnvio', '') == envioId;

      // Aprobar o rechazar (y bajar el contador) llega con HU-13.
      allow update, delete: if false;
    }

    // Cualquier otra colección queda cerrada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
