rules_version = '2';

// Reglas de seguridad de El Rincón de los Trabalenguas.
// Sprint 1: usuarios (HU-01, HU-02) y lectura del catálogo aprobado (HU-04, HU-05).
// Sprint 2: los usuarios proponen trabalenguas en `envios` (HU-12).
// Sprint 4: el editor de contenido (rol «moderador») aprueba o rechaza envíos (HU-13). Aprobar publica
// el envío en `trabalenguas` con el mismo id. La semilla se sigue cargando con scripts/seed.js (Admin SDK).

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    function rutaUsuario(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function rutaEnvio(envioId) {
      return /databases/$(database)/documents/envios/$(envioId);
    }

    function rutaTrabalenguas(id) {
      return /databases/$(database)/documents/trabalenguas/$(id);
    }

    // HU-13: el rol «moderador» solo se asigna desde la consola de Firebase (nadie se lo pone a sí mismo).
    function esModerador() {
      return autenticado()
        && exists(rutaUsuario(request.auth.uid))
        && get(rutaUsuario(request.auth.uid)).data.get('rol', '') == 'moderador';
    }

    // HU-12: máximo de envíos pendientes por usuario.
    function maxPendientes() {
      return 5;
    }

    // ---------- usuarios/{uid} ----------
    // El correo es privado: solo el dueño lee su documento.
    match /usuarios/{uid} {
      allow read: if esDueno(uid);

      // HU-01: el registro crea el documento con rol «usuario»,
      // la aceptación del aviso de privacidad y la mayoría de edad.
      allow create: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['email', 'rol', 'aceptoPrivacidad', 'mayorDeEdad', 'creado'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.rol == 'usuario'
        && request.resource.data.aceptoPrivacidad == true
        && request.resource.data.mayorDeEdad == true
        && request.resource.data.creado == request.time;

      // Nadie cambia su propio rol ni su correo desde el cliente.
      // HU-12: lo único que el dueño puede cambiar es su contador de envíos pendientes, y solo
      // subiéndolo de 1 en 1 (hasta 5) en la misma escritura que crea el envío `ultimoEnvio`.
      allow update: if (esDueno(uid)
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly([])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enviosPendientes', 'ultimoEnvio'])
            && request.resource.data.enviosPendientes == resource.data.get('enviosPendientes', 0) + 1
            && request.resource.data.enviosPendientes <= maxPendientes()
            && request.resource.data.ultimoEnvio is string
            && !exists(rutaEnvio(request.resource.data.ultimoEnvio))
            && existsAfter(rutaEnvio(request.resource.data.ultimoEnvio))
            && getAfter(rutaEnvio(request.resource.data.ultimoEnvio)).data.autorId == uid)))
        // HU-13: el moderador baja en 1 el contador del autor en la misma escritura en la que aprueba
        // o rechaza uno de sus envíos pendientes (`ultimaRevision` apunta a ese envío).
        || (esModerador()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enviosPendientes', 'ultimaRevision'])
          && request.resource.data.enviosPendientes == resource.data.get('enviosPendientes', 0) - 1
          && request.resource.data.enviosPendientes >= 0
          && request.resource.data.ultimaRevision is string
          && exists(rutaEnvio(request.resource.data.ultimaRevision))
          && get(rutaEnvio(request.resource.data.ultimaRevision)).data.autorId == uid
          && get(rutaEnvio(request.resource.data.ultimaRevision)).data.estado == 'pendiente'
          && getAfter(rutaEnvio(request.resource.data.ultimaRevision)).data.estado in ['aprobado', 'rechazado']);

      // La eliminación de cuenta llega en el Sprint 4 (HU-18).
      allow delete: if false;
    }

    // ---------- trabalenguas/{id} ----------
    // HU-04 y HU-05: cualquiera, con o sin sesión, lee solo los aprobados.
    // Un trabalenguas pendiente o rechazado se comporta como «no encontrado».
    function ejemploValido(lista, i) {
      return lista.size() <= i || (lista[i] is string && lista[i].size() >= 20 && lista[i].size() <= 160);
    }

    match /trabalenguas/{id} {
      allow read: if resource.data.estado == 'aprobado';

      // HU-13: el moderador publica un envío pendiente con el mismo id, en la misma escritura en la que
      // marca el envío como aprobado. Puede corregir el texto, el concepto o la definición antes de publicar.
      allow create: if esModerador()
        && request.resource.data.keys().hasOnly(['titulo', 'texto', 'concepto', 'definicion', 'area', 'dificultad', 'autorNombre', 'estado', 'creado', 'fuente', 'ejemplos'])
        && request.resource.data.keys().hasAll(['titulo', 'texto', 'concepto', 'definicion', 'area', 'dificultad', 'autorNombre', 'estado', 'creado'])
        && request.resource.data.estado == 'aprobado'
        && request.resource.data.creado == request.time
        && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 1 && request.resource.data.titulo.size() <= 80
        && request.resource.data.texto is string && request.resource.data.texto.size() >= 20 && request.resource.data.texto.size() <= 500
        && request.resource.data.concepto is string && request.resource.data.concepto.size() >= 1 && request.resource.data.concepto.size() <= 60
        && request.resource.data.definicion is string && request.resource.data.definicion.size() >= 1 && request.resource.data.definicion.size() <= 200
        && request.resource.data.autorNombre is string && request.resource.data.autorNombre.size() >= 1 && request.resource.data.autorNombre.size() <= 40
        && request.resource.data.area in ['Scrum', 'Planeación', 'Riesgos', 'Calidad', 'Liderazgo']
        && request.resource.data.dificultad in ['Fácil', 'Medio', 'Difícil']
        && (!('fuente' in request.resource.data) || request.resource.data.fuente in ['Guía Scrum', 'PMBOK', 'Guía Scrum y PMBOK', 'Prácticas ágiles', 'Ingeniería de software'])
        && (!('ejemplos' in request.resource.data) || (request.resource.data.ejemplos is list
          && request.resource.data.ejemplos.size() >= 1 && request.resource.data.ejemplos.size() <= 3
          && ejemploValido(request.resource.data.ejemplos, 0)
          && ejemploValido(request.resource.data.ejemplos, 1)
          && ejemploValido(request.resource.data.ejemplos, 2)))
        && exists(rutaEnvio(id))
        && get(rutaEnvio(id)).data.estado == 'pendiente'
        && getAfter(rutaEnvio(id)).data.estado == 'aprobado';

      allow update, delete: if false;
    }

    // ---------- progreso/{uid}_{trabalenguasId} ----------
    // HU-07 (favoritos), HU-08 (dominado), HU-09 (temporizador) y HU-21 (etapas de la ruta).
    // Cada usuario lee y escribe únicamente su propio progreso (RNF-03).
    // HU-21: etapas es un mapa de booleanos con las etapas de la ruta: ordena, completa y memorama.
    // `lee` y `dilo` (karaoke y voz, retirados el 2 de noviembre) se siguen aceptando para no romper
    // los documentos que ya los tienen; la app ya no los escribe.
    function etapasValidas(datos) {
      return !('etapas' in datos) || (datos.etapas is map
        && datos.etapas.keys().hasOnly(['ordena', 'completa', 'memorama', 'lee', 'dilo'])
        && (!('lee' in datos.etapas) || datos.etapas.lee is bool)
        && (!('ordena' in datos.etapas) || datos.etapas.ordena is bool)
        && (!('completa' in datos.etapas) || datos.etapas.completa is bool)
        && (!('dilo' in datos.etapas) || datos.etapas.dilo is bool)
        && (!('memorama' in datos.etapas) || datos.etapas.memorama is bool));
    }

    match /progreso/{docId} {
      allow get: if autenticado() && docId.matches(request.auth.uid + '_.*');
      allow list: if autenticado() && resource.data.usuarioId == request.auth.uid;

      allow create, update: if autenticado()
        && docId.matches(request.auth.uid + '_.*')
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.keys().hasOnly(['usuarioId', 'trabalenguasId', 'esFavorito', 'dominado', 'mejorTiempoSeg', 'practicas', 'ultimaPractica', 'etapas'])
        && (!('esFavorito' in request.resource.data) || request.resource.data.esFavorito is bool)
        // HU-08: dominado es un booleano.
        && (!('dominado' in request.resource.data) || request.resource.data.dominado is bool)
        // HU-09: mejor tiempo (segundos, mayor a 0), número de prácticas y fecha de la última práctica.
        && (!('mejorTiempoSeg' in request.resource.data) || (request.resource.data.mejorTiempoSeg is number && request.resource.data.mejorTiempoSeg > 0))
        && (!('practicas' in request.resource.data) || request.resource.data.practicas is int)
        && (!('ultimaPractica' in request.resource.data) || request.resource.data.ultimaPractica is timestamp)
        && etapasValidas(request.resource.data);

      allow delete: if false;
    }

    // ---------- envios/{envioId} ----------
    // HU-12: propuestas de trabalenguas. Se crean como «pendiente» y no aparecen en el catálogo.
    // Cada envío sube en 1 el contador `enviosPendientes` del autor en la misma escritura (batch);
    // así las reglas imponen el máximo de 5 sin tener que contar documentos.
    match /envios/{envioId} {
      // HU-15: cada autor lee solo sus envíos (las consultas deben filtrar por autorId).
      // HU-13: el moderador lee todos para revisarlos (la página de moderación filtra por estado).
      allow read: if autenticado() && (resource.data.autorId == request.auth.uid || esModerador());

      allow create: if autenticado()
        && request.resource.data.keys().hasOnly(['autorId', 'autorNombre', 'titulo', 'texto', 'concepto', 'definicion', 'area', 'dificultad', 'estado', 'creado'])
        && request.resource.data.keys().hasAll(['autorId', 'autorNombre', 'titulo', 'texto', 'concepto', 'definicion', 'area', 'dificultad', 'estado', 'creado'])
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.creado == request.time
        && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 1 && request.resource.data.titulo.size() <= 80
        && request.resource.data.texto is string && request.resource.data.texto.size() >= 20 && request.resource.data.texto.size() <= 500
        && request.resource.data.concepto is string && request.resource.data.concepto.size() >= 1 && request.resource.data.concepto.size() <= 60
        && request.resource.data.definicion is string && request.resource.data.definicion.size() >= 1 && request.resource.data.definicion.size() <= 200
        // Nombre público con el que aparecerá el autor al publicarse (decidido el 30 de octubre).
        && request.resource.data.autorNombre is string && request.resource.data.autorNombre.size() >= 1 && request.resource.data.autorNombre.size() <= 40
        && request.resource.data.area in ['Scrum', 'Planeación', 'Riesgos', 'Calidad', 'Liderazgo']
        && request.resource.data.dificultad in ['Fácil', 'Medio', 'Difícil']
        // El contador del autor sube en 1 en la misma escritura y apunta a este envío.
        && getAfter(rutaUsuario(request.auth.uid)).data.get('enviosPendientes', 0) == get(rutaUsuario(request.auth.uid)).data.get('enviosPendientes', 0) + 1
        && getAfter(rutaUsuario(request.auth.uid)).data.get('ultimoEnvio', '') == envioId;

      // HU-13: el moderador aprueba o rechaza un envío pendiente, una sola vez.
      // - Rechazar exige un motivo (5 a 200 caracteres), que HU-15 le muestra al autor.
      // - Aprobar exige publicar el trabalenguas con el mismo id en la misma escritura.
      // - En ambos casos, el contador de pendientes del autor baja en 1 en la misma escritura.
      allow update: if esModerador()
        && resource.data.estado == 'pendiente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'motivo', 'revisado'])
        && request.resource.data.revisado == request.time
        && ((request.resource.data.estado == 'rechazado'
              && request.resource.data.motivo is string
              && request.resource.data.motivo.size() >= 5 && request.resource.data.motivo.size() <= 200)
          || (request.resource.data.estado == 'aprobado'
              && !('motivo' in request.resource.data)
              && existsAfter(rutaTrabalenguas(envioId))))
        && getAfter(rutaUsuario(resource.data.autorId)).data.get('enviosPendientes', 0)
          == get(rutaUsuario(resource.data.autorId)).data.get('enviosPendientes', 0) - 1;

      allow delete: if false;
    }

    // Cualquier otra colección queda cerrada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
