{
  "name": "rincon-trabalenguas",
  "version": "0.1.0",
  "private": true,
  "description": "El Rincón de los Trabalenguas: aprende a administrar proyectos trabalenguando.",
  "type": "module",
  "scripts": {
    "emuladores": "firebase emulators:start --project demo-rincon-trabalenguas --import=./.emulador --export-on-exit",
    "seed:emulador": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/seed.js",
    "seed": "node scripts/seed.js",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-rincon-trabalenguas \"node --test tests/\"",
    "deploy:staging": "firebase hosting:channel:deploy staging --expires 30d",
    "deploy": "firebase deploy --only hosting,firestore:rules,firestore:indexes"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.2",
    "firebase-admin": "^12.2.0",
    "firebase-tools": "^13.11.2"
  }
}
